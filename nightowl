#!/usr/bin/env python3
# nightowl -- thin launcher. The CLI implementation lives in
# nightowl_pkg/cli.py (also exposed as the `nightowl` console script when
# installed via pip).
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from nightowl_pkg.cli import main  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nInterrupted.")
        sys.exit(130)
